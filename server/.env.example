# Copy to .env for local development. In production (cPanel "Setup Node.js App"
# or any other host), set these as real environment variables instead — never
# commit a real .env file.

NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=portfolio
DB_SSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated exact-match origins allowed to call /api/public/*.
# Vercel preview deployments (https://*.vercel.app) are always allowed in addition to this list.
CORS_ALLOWED_ORIGINS=https://pappudey.com,http://localhost:5173,http://localhost:5174

