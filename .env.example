# Copy to .env.local for a personal override, or set directly in Vercel's
# project settings for production. Never commit real secrets here — this
# file only documents what's expected.

# Base URL of the backend API (server/). Currently used to resolve the
# admin-managed CV/résumé download link; leave unset to fall back to the
# bundled static file. Set this once the API is actually deployed somewhere.
VITE_API_BASE_URL=
